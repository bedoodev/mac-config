# ~/.config/ghostty/config.ghostty

# Theme
theme = Catppuccin Mocha
window-theme = dark

# Font
font-family = JetBrains Mono
font-size = 17
font-thicken = true

# Window
background-opacity = 0.82
background-blur = 40
window-padding-x = 14
window-padding-y = 10
macos-titlebar-style = tabs

# Cursor
cursor-style = bar
cursor-style-blink = true

# Mouse & Clipboard
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = always

# Shell
shell-integration = zsh

# macOS
macos-option-as-alt = left

# Tabs & Splits
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+shift+enter=new_split:down
keybind = super+shift+d=new_split:right

# Clipboard
# Ghostty seçimi varsa onu kopyala; yoksa Cmd+C'yi çalışan uygulamaya geçir.
keybind = performable:super+c=copy_to_clipboard:mixed
keybind = super+v=paste_from_clipboard

# Send single-byte control codes that pass through the PTY unchanged.
keybind = super+a=text:\x01
keybind = super+b=text:\x02
keybind = super+z=text:\x1a
keybind = super+shift+z=text:\x19

# Shift + Arrow
keybind = shift+left=csi:1;2D
keybind = shift+right=csi:1;2C
keybind = shift+up=csi:1;2A
keybind = shift+down=csi:1;2B

# Shift + Option + Arrow
keybind = shift+alt+left=csi:1;4D
keybind = shift+alt+right=csi:1;4C

# Cmd + Arrow
keybind = super+left=csi:H
keybind = super+right=csi:F
keybind = super+up=csi:1;5H
keybind = super+down=csi:1;5F

# Cmd + Shift + Arrow
keybind = super+shift+left=csi:1;2H
keybind = super+shift+right=csi:1;2F
keybind = super+shift+up=csi:1;6H
keybind = super+shift+down=csi:1;6F

# Shift + Enter
keybind = shift+enter=csi:13;2u
