[init]
	defaultBranch = main

[core]
	editor = micro
	autocrlf = input

[pull]
	ff = only

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[rerere]
	enabled = true

[credential]
	helper = osxkeychain

# Keep your personal name and email in ~/.gitconfig.local, outside this repository.
[include]
	path = ~/.gitconfig.local
